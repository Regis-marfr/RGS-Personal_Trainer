# ============================================================
# RGS Personal Trainer — Variáveis de Ambiente
# ============================================================
# Copie este arquivo como .env para desenvolvimento local.
# No Vercel, configure cada variável em:
# Dashboard → Projeto → Settings → Environment Variables
# ============================================================

# PostgreSQL Connection (Supabase)
# Obtenha em: Supabase → Project → Settings → Database → Connection String (URI)
# Use o modo "Session Mode" (porta 5432) para o Vercel
POSTGRES_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# JWT Secret — Use uma string longa e aleatória (mínimo 32 caracteres)
# Gere em: https://generate-secret.vercel.app/64
JWT_SECRET=SUBSTITUA_POR_UMA_CHAVE_SECRETA_LONGA_E_ALEATORIA

# Gmail SMTP — Conta para envio de e-mails do sistema
# ATENÇÃO: Use uma Senha de App, não sua senha normal do Gmail
# Como gerar: Conta Google → Segurança → Verificação em 2 Etapas → Senhas de App
GMAIL_USER=regimarfr@gmail.com
GMAIL_APP_PASS=micnitugytxogfgf

# Porta local (somente para desenvolvimento)
PORT=3000
